<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/prayertime_widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_artwork" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/widget_label" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:text="Next prayer" android:textColor="#6F4B94" />
        <TextView android:id="@+id/widget_prayer" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:text="PrayerTime" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="23sp" android:autoSizeStepGranularity="1sp" android:minHeight="31dp" android:textStyle="bold" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/widget_time" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="29sp" android:text="" android:layout_marginTop="1dp" android:minHeight="37dp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="15sp" android:autoSizeMaxTextSize="29sp" android:autoSizeStepGranularity="1sp" />
        <LinearLayout android:orientation="vertical" android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/widget_date" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:text="" android:visibility="gone" />
        <TextView android:id="@+id/widget_location" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:text="PrayerTime" android:layout_marginTop="6dp" android:textColor="#746A7D" />
    </LinearLayout>
</FrameLayout>