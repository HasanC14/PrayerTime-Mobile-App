<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/prayertime_widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_artwork" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/widget_label" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:text="Prayer times" android:textStyle="bold" />
        <TextView android:id="@+id/widget_date" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:text="" android:textColor="#6F4B94" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="10dp" android:layout_marginBottom="4dp">
            <FrameLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/widget_row_0_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/widget_row_0_name" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:text="Fajr" android:layout_weight="1" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/widget_row_0_time" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:text="" android:layout_weight="1.15" android:gravity="end|center_vertical" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/widget_row_1_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/widget_row_1_name" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:text="Dhuhr" android:layout_weight="1" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/widget_row_1_time" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:text="" android:layout_weight="1.15" android:gravity="end|center_vertical" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/widget_row_2_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/widget_row_2_name" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:text="Asr" android:layout_weight="1" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/widget_row_2_time" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:text="" android:layout_weight="1.15" android:gravity="end|center_vertical" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/widget_row_3_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/widget_row_3_name" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:text="Maghrib" android:layout_weight="1" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/widget_row_3_time" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:text="" android:layout_weight="1.15" android:gravity="end|center_vertical" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/widget_row_4_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/widget_row_4_name" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:text="Isha" android:layout_weight="1" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/widget_row_4_time" style="@style/PrayerTimeWidgetText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:text="" android:layout_weight="1.15" android:gravity="end|center_vertical" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_location" style="@style/PrayerTimeWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:text="" android:textColor="#746A7D" />
    </LinearLayout>
</FrameLayout>
