{
  "expo": {
    "name": "PrayerTime",
    "slug": "prayertime-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo512.png",
    "userInterfaceStyle": "automatic",
    "scheme": "prayertime",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.hubxpert.prayertime",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PrayerTime uses your location to calculate accurate prayer times for your current city."
      }
    },
    "android": {
      "package": "com.hubxpert.prayertime",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo512.png",
        "backgroundColor": "#ecdfee"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PrayerTime uses your location to calculate accurate prayer times for your current city."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#170939",
          "defaultChannel": "prayer-times"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-transparent.png",
          "backgroundColor": "#B99ADB"
        }
      ],
      "expo-font"
    ]
  }
}
