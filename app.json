{
  "expo": {
    "name": "PrayerTime",
    "slug": "prayertime-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "prayertime",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.hubxpert.prayertime",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PrayerTime uses your location to calculate accurate prayer times for your current city."
      }
    },
    "android": {
      "package": "com.hasanbuilds.prayertime",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png",
        "backgroundColor": "#F4EDF8"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PrayerTime uses your location to calculate accurate prayer times for your current city.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#BFA5D4",
          "defaultChannel": "prayer-times"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-transparent.png",
          "backgroundColor": "#F6F4F8"
        }
      ],
      "expo-font",
      "./plugins/withWidgetArtwork",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.hubxpert.prayertime.widgets",
          "groupIdentifier": "group.com.hubxpert.prayertime",
          "widgets": [
            {
              "name": "PrayerHero",
              "displayName": "Prayer card",
              "description": "Your prayer card, with artwork, countdown and the next prayer.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "NextPrayer",
              "displayName": "Next prayer",
              "description": "Your next prayer, start time, and saved location.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "DaySummary",
              "displayName": "Day summary",
              "description": "Current prayer, Hijri date, and sunrise/sunset or fasting times.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "PrayerTimes",
              "displayName": "Prayer times",
              "description": "All five prayer start times for your day.",
              "ios": {
                "supportedFamilies": [
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "./plugins/withWidgetLayoutDirection",
      "expo-asset",
      "./plugins/withAndroidReleaseOptimization",
      "expo-background-task",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "e39d7104-76a0-4bc5-ab7d-fc2e605d0fef"
      }
    }
  }
}
